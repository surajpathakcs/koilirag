# ── Koili TMS RAG — fully local config ────────────────────────────────────────
# Copy to .env and adjust. No external API keys are needed.

# LLM (local, OpenAI-compatible endpoint)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# Optional smaller/faster model for planner + grader (defaults to LLM_MODEL)
LLM_MODEL_FAST=qwen2.5:3b-instruct-q4_K_M
LLM_TIMEOUT=120

# Embeddings (local, fastembed ONNX on CPU)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Vector store — embedded Qdrant (local directory, no server)
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=koili_tms_manual
# To use a Qdrant server instead, set QDRANT_URL (and QDRANT_API_KEY if secured)
# QDRANT_URL=http://localhost:6333

# Retrieval tuning
RETRIEVAL_CANDIDATES=25
RETRIEVAL_TOP_N=5

# Graph
ENABLE_GRADER=true

# Observability (optional — leave unset to disable)
# LOGFIRE_TOKEN=
LOGFIRE_IGNORE_NO_CONFIG=1

ENVIRONMENT=local
