# ── Koili TMS RAG — fully local config ────────────────────────────────────────
# Copy to .env and adjust. No external API keys are needed.

# LLM (local, OpenAI-compatible endpoint)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# On a CPU VPS, qwen2.5:3b-instruct answers in ~15-25s; 7b in ~40-90s.
# Start with 3b for both, move the responder to 7b once it works.
LLM_MODEL=qwen2.5:3b-instruct
LLM_MODEL_FAST=qwen2.5:3b-instruct
LLM_TIMEOUT=300
LLM_MAX_TOKENS=900

# Embeddings (local, via Ollama; dimension is probed automatically)
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Vector store — embedded Qdrant (local directory, no server)
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=koili_tms_manual
# To use a Qdrant server instead, set QDRANT_URL (and QDRANT_API_KEY if secured)
# QDRANT_URL=http://localhost:6333

# Retrieval tuning
RETRIEVAL_CANDIDATES=25
RETRIEVAL_TOP_N=5

# Graph — grader adds a second LLM call per query (slow on CPU)
ENABLE_GRADER=false

# Telemetry is hard-disabled in code (logfire send_to_logfire=False).
# Nothing is sent off the machine.

ENVIRONMENT=local
